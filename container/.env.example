# Copy this file to container/.env and fill in real host paths before
# running `docker compose -f container/compose.yaml up`. Nothing in this
# file is a secret: it only points at where secrets live on the host. The
# actual SSH private key stays wherever SSH_KEY_FILE points to, owned by
# the operator, never checked into this repository.
#
# See "Non-root and the NAS uid/gid" in docs/deployment.md before changing
# PUID/PGID: whatever you set here has to match the ownership you already
# gave STATE_DIR and BACKUP_DIR on the host, because this image has no
# shell and no root step to fix that up for you at startup.

# The UGREEN NAS admin account's uid/gid. 1000 is the common default for
# the first account on a Linux-based NAS distribution (UGOS included) —
# check `id <your-admin-user>` on the NAS if you're not sure.
PUID=1000
PGID=1000

# Host directory for the persistent SQLite lifecycle journal (FR-9). Must
# already exist and be owned by PUID:PGID.
STATE_DIR=/volume1/backup-manager/state

# Host directory (NAS backup volume/share) that completed, verified
# artifacts land in. Must already exist and be owned by PUID:PGID.
BACKUP_DIR=/volume1/backups

# Host DIRECTORY holding the manager configuration (internal/config's
# Config, see docs/EPIC.md FR-5). config.yaml lives inside it, and so do
# the engine's two on-demand stores, ssh_keys/ and known_hosts.d/. Mounted
# writable and owned by PUID:PGID: adding a backup set, saving settings
# and first-run setup all replace config.yaml through a temp file created
# in this directory (issue #196). It may legitimately be empty on a fresh
# install.
CONFIG_DIR=/volume1/backup-manager/config

# SFTP client private key and pinned known_hosts (FR-6). Both mounted
# read-only. Keep the key file itself at host mode 0600, owned by whoever
# manages it on the NAS.
SSH_KEY_FILE=/volume1/backup-manager/secrets/id_ed25519
KNOWN_HOSTS_FILE=/volume1/backup-manager/secrets/known_hosts

# Host port the web-ui service's HTTP listener is published on
# (container/compose.yaml maps this to that container's own LISTEN_ADDR,
# always :8080 inside it). The rclone-manager engine service has no
# published port at all - it's reachable only from web-ui, over the
# internal Docker network compose.yaml defines. Change this if 8080 is
# already taken on the host; put this behind your own reverse proxy for
# TLS.
LISTEN_PORT=8080

# Externally-reachable base URL for the one-time enrollment link
# rclone-manager prints on first start (its own --listen address is
# never externally reachable, since it has no published port - see
# compose.yaml's own comment on PUBLIC_BASE_URL). Left commented out,
# compose.yaml defaults this to http://localhost:${LISTEN_PORT} - correct
# when you open the link on the NAS itself, wrong from anywhere else on
# the LAN. Uncomment and set this to the NAS's real hostname/IP (matching
# LISTEN_PORT above) to get a link that works from another machine too.
#PUBLIC_BASE_URL=http://your-nas.local:8080

# How much both containers log. `info` (the default when this is unset)
# is what a deployment has always emitted: startup, lifecycle moves,
# failures. `debug` adds the per-request diagnostics issue #730 was
# reported for - the engine's record of what it served, and web-ui's
# trace of what the engine answered and how much of the body reached the
# browser - each line naming the same correlation id so the two
# containers' accounts of one request can be joined.
#
# compose.yaml passes this to BOTH services, which is the only useful
# way to set it: one container at `debug` records half of every story.
# Setting RM_DEBUG=1 in the environment instead is the same switch, kept
# as the shortcut an operator can be given over a phone call.
#
# Leave it at `info` for normal operation: `debug` writes a line per API
# request. The browser has its own separate half, which is NOT this
# variable - see "Turning on diagnostics" in docs/deployment.md.
#LOG_LEVEL=info

# Build stamps (see Dockerfile). From a real checkout:
#   VERSION=$(git describe --tags --always)
#   COMMIT=$(git rev-parse HEAD)
VERSION=dev
COMMIT=none
