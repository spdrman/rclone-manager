#!/usr/bin/env sh
# Pre-commit gate mirroring .github/workflows/ci.yml, in the same spirit as
# iasbuilt/webapp's hook: stop a commit that cannot build, not a commit with
# style debt.
#
# WHAT RUNS HERE, AND WHY THIS SUBSET.
#
# Go: build, vet, and core/'s ./internal/... suite (core/ is its own Go
# module as of #106/B1.1 — docs/EPIC-B-multi-nas.md §7). Deliberately NOT
# `go test ./...`. core/'s ./tests/... tree holds the crash matrix, the SFTP
# integration suite and the destructive-safety suite, which stand up Docker
# containers and kill real processes. Those take minutes, need a working
# Docker daemon, and would make this hook unusable on a laptop with Docker
# stopped. CI runs them on every push, which is where a suite that slow
# belongs. `./internal/...` is around a minute and covers every package the
# commit is likely to have touched.
#
# apps/common is a second, much smaller Go module (the platform-capability
# contract plus reserved webhost/auth/local scaffolding) — build, vet and
# test run in full since none of it is slow.
#
# Frontend: tsc --noEmit and the vitest suite, both of which are about a second.
# Playwright is NOT here, for the same reason as the Go integration tree: it
# needs browsers installed and takes far longer than a commit should. Run
# `npm run e2e` before a PR.
#
# ESLint is not here either, matching webapp's reasoning: a lint ratchet exists
# to block a merge, and a local commit is not a merge.
#
# THE THREE TIERS, so nobody has to reconstruct them from three files:
#   this hook      build, vet, ./internal/... , ui typecheck and unit tests
#   ci.yml         the same, plus the UI build and both cross-compiles
#   nightly-e2e    Playwright, on main only, because a browser suite is too
#                  slow and too flaky to sit in front of a merge
#
# `git commit --no-verify` is the documented escape hatch for a WIP commit you
# will fix before pushing.

set -e

export PATH="/opt/homebrew/bin:$PATH"

echo "==> pre-commit: core/ go build"
(cd core && go build ./...)

echo "==> pre-commit: core/ go vet"
(cd core && go vet ./...)

echo "==> pre-commit: core/ go test ./internal/..."
(cd core && go test ./internal/...)

if [ -d apps/common ]; then
  echo "==> pre-commit: apps/common go build, vet, test"
  (cd apps/common && go build ./... && go vet ./... && go test ./...)
fi

# The frontend only exists once ui/shared is present, and a Go-only checkout
# should not fail this hook.
if [ -d ui/shared ]; then
  if [ ! -d ui/shared/node_modules ]; then
    echo "==> pre-commit: ui/shared has no node_modules, skipping frontend checks"
    echo "    run 'cd ui/shared && npm install' to enable them"
  else
    echo "==> pre-commit: ui typecheck"
    (cd ui/shared && npm run --silent lint)

    echo "==> pre-commit: ui tests"
    (cd ui/shared && npm test --silent)
  fi
fi

echo "==> pre-commit: ok"
