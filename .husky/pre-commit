#!/usr/bin/env sh
# GitHub Actions is no longer the gate for this repo (see the "on:" blocks
# in .github/workflows/*.yml — ci.yml and rclone-upgrade-gate.yml are both
# workflow_dispatch-only now, nightly-e2e.yml's schedule trigger is
# disabled). This hook, via scripts/ci-local.sh, IS the CI: it mirrors
# ci.yml job-for-job, not just a fast subset of it.
#
# This makes commits slow (the full core/ suite includes the Docker-backed
# crash matrix and SFTP integration tests, plus two cross-compiles, three
# frontend installs/builds, and the dependency-rules worktree-deletion
# proofs). That's the deliberate tradeoff of relying on this instead of
# GitHub Actions: see scripts/ci-local.sh's own header for the CI_LOCAL_FAST
# escape hatch for iteration, and never rely on it before a merge.
#
# In a fresh clone or a new `git worktree`, the first commit stops before it
# runs anything: node_modules/ is gitignored, and since #160 the gate refuses
# to report on frontend and conformance checks it cannot perform instead of
# skipping them and printing "ci-local: ok" anyway. It names every
# uninstalled workspace and the command that fixes it. Run those, or set
# CI_LOCAL_SKIP_JS=1 to leave them out on purpose. The same now goes for a
# stopped Docker daemon and CI_LOCAL_SKIP_DOCKER=1.
#
# Three outcomes, and this hook has to make its own decision about the
# middle one rather than inherit it by accident:
#
#   0  the gate performed every applicable check          -> commit
#   3  the gate ran but skipped something (INCOMPLETE)    -> commit, loudly
#   *  something actually failed                          -> block
#
# Tolerating 3 is the policy that keeps CI_LOCAL_FAST=1 usable for iteration,
# and it belongs here, where a human reads the warning, rather than inside
# the gate where it would look like success. Anything that merges on this
# gate's word must require 0.
#
# Playwright e2e is still not here, matching nightly-e2e.yml's own reasoning
# (too slow, too flaky to sit in front of every commit) — run it by hand
# (`cd ui/shared && npm run e2e`) or via workflow_dispatch before a release.
#
# `git commit --no-verify` is the documented escape hatch for a WIP commit
# you will fix before pushing.

set -e

gate_status=0
bash scripts/ci-local.sh || gate_status=$?

if [ "$gate_status" -eq 0 ]; then
  exit 0
fi

if [ "$gate_status" -eq 3 ]; then
  echo "" >&2
  echo "==> pre-commit: allowing this commit on an INCOMPLETE gate run." >&2
  echo "    The checks listed above did not run, so this commit is not backed by" >&2
  echo "    merge evidence. Run scripts/ci-local.sh with CI_LOCAL_FAST," >&2
  echo "    CI_LOCAL_SKIP_JS and CI_LOCAL_SKIP_DOCKER unset before you merge." >&2
  exit 0
fi

exit "$gate_status"
