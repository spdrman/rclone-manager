{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/*"
      ],
      "@platform-entry": [
        "../../apps/generic/frontend/bootstrap.tsx"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "../../apps"
  ]
}
