{
  "name": "@backup-manager/ui-shared",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundles": "node scripts/build-bundles.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "eslint": "eslint .",
    "typecheck:providers": "tsc --noEmit -p tsconfig.providers.json",
    "test:all": "npm run lint && npm run eslint && npm run typecheck:providers && npm test"
  },
  "dependencies": {
    "@causlts/core": "0.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
