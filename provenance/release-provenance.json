      "target": "synology",
      "reason": "the shipped artifact is a .spk, assembled by apps/synology/cmd/spkctl at release time rather than checked in; #85 owns building it and re-deriving each embedded binary's SHA-256 out of the finished package against container/release-manifest.json"
    },
    {
      "target": "ugos",
      "reason": "the shipped artifact is a .upk, packed by ugcli against a known canonical image digest; that build is EPIC D's #83 and its App Center submission is #178, neither of which happens in this repository's gate"
    }
