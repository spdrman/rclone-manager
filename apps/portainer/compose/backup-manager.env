# Environment for backup-manager.yml (issue #170, B6.6).
#
# Portainer does not read this file. It is the authoritative copy of the
# values the App Template in ../templates.json puts in front of an
# operator, and distribution/packaging fails the build when the two
# disagree, so the form and the stack can never drift apart.
#
# Copy it next to the compose file as `.env` if you deploy the stack with
# `docker compose` directly instead of through Portainer.
#
# Nothing in this file is a secret. It only points at where things live on
# the Docker host: the SSH private key stays wherever KEY_FILE points,
# owned by you, never checked into this repository and never baked into
# the image. distribution/packaging scans this file for credential
# material on every commit.

# The canonical OCI image. No registry is configured for this repository
# yet, so this reference does not resolve until you push it somewhere or
# load a saved image on the host; see step 0 of
# docs/acceptance/portainer-stack-deployment.md. Change it here and in the
# App Template, and nowhere else.
IMAGE=ghcr.io/spdrman/backup-manager:0.2.0

# The account the containers run as. Must already own STATE_DIR,
# BACKUP_DIR and CONFIG_DIR: the runtime image is distroless, with no
# shell and no root step, so nothing inside the container can chown them
# at startup.
PUID=1000
PGID=1000

# Private application state: the SQLite catalog and the
# local-authentication administrator record (an Argon2id hash, never a
# plaintext value).
STATE_DIR=/opt/backup-manager/state

# The user backup root: where retained artifacts land. A separate security
# domain from everything above (section 19.2), so no key material or
# authentication state ever lives inside it.
BACKUP_DIR=/opt/backup-manager/backups

# A writable directory holding config.yaml. The engine creates and
# atomically replaces that file, and its ssh_keys/ and known_hosts.d/
# stores are siblings of it, so this is a directory and not a file mount
# (issue #196). It may legitimately be empty on a fresh install.
CONFIG_DIR=/opt/backup-manager/config

KEY_FILE=/opt/backup-manager/secrets/id_ed25519
KNOWN_HOSTS_FILE=/opt/backup-manager/secrets/known_hosts

# The host port the Web UI is published on. Portainer shows it as the
# stack's published port; the engine has none.
WEB_PORT=8080

# Timezone the engine evaluates retention boundaries in.
TZ=UTC

# Externally reachable base URL for the one-time enrollment link the
# engine prints on first start. "localhost" is only right when you open
# the link on the Docker host itself.
PUBLIC_BASE_URL=http://localhost:8080
