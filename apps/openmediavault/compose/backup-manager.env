# Environment for backup-manager.yml, pasted into the Environment field of
# Services -> Compose -> Files -> backup-manager in the OMV Workbench
# (WP4.3, deliverable D-8).
#
# Nothing in this file is a secret. It only points at where things live on
# the host: the SSH private key stays wherever KEY_FILE points, owned by
# you, never checked into this repository and never baked into the image.
# apps/common/packaging scans this file for credential material on every
# commit.
#
# THE ONE SUBSTITUTION THAT MATTERS
#
# DISK below is a placeholder. A real OMV system mounts data filesystems
# at /srv/dev-disk-by-uuid-<UUID>/, and the UUID differs per machine, so
# no checked-in default can be literally correct. Find yours with
#
#     ls -d /srv/dev-disk-by-uuid-*
#
# and set DISK to it. Every host path below derives from DISK, so the UUID
# appears exactly once on your system rather than five times.
DISK=/srv/dev-disk-by-uuid

# The canonical OCI image. No registry is configured for this repository
# yet, so this reference does not resolve until you push it somewhere or
# load a saved image locally; see step 0.2 of
# docs/acceptance/openmediavault-provider-acceptance.md. Change it here
# and nowhere else.
IMAGE=ghcr.io/spdrman/backup-manager:1.0.0

# The account the containers run as. Must already own STATE_DIR and
# BACKUP_DIR: the runtime image is distroless, with no shell and no root
# step, so nothing inside the container can chown them at startup. Check
# yours with `id <your-admin-user>`.
PUID=1000
PGID=100

# Private application state: the SQLite catalog and the
# local-authentication administrator record (an Argon2id hash, never a
# plaintext password).
STATE_DIR=/srv/dev-disk-by-uuid/appdata/backup-manager/state

# The user backup root: where retained artifacts land. A separate security
# domain from everything above (§19.2), so no key material or
# authentication state ever lives inside it.
BACKUP_DIR=/srv/dev-disk-by-uuid/backups

# Read-only mounts. The engine loads and validates CONFIG_FILE before it
# opens a listener, so it must exist and be valid before the first start.
CONFIG_FILE=/srv/dev-disk-by-uuid/appdata/backup-manager/config/config.yaml
KEY_FILE=/srv/dev-disk-by-uuid/appdata/backup-manager/secrets/id_ed25519
KNOWN_HOSTS_FILE=/srv/dev-disk-by-uuid/appdata/backup-manager/secrets/known_hosts

# The host port the Web UI is published on. Do not collide with the OMV
# Workbench's own port.
WEB_PORT=8080

# Externally reachable base URL for the one-time enrollment link the
# engine prints on first start. "localhost" is only right when you open
# the link on the NAS itself; set your host's real name to get a link that
# works from another machine.
PUBLIC_BASE_URL=http://localhost:8080
