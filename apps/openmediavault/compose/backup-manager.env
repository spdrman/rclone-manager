# Environment for backup-manager.yml, pasted into the Environment field of
# Services -> Compose -> Files -> backup-manager in the OMV Workbench
# (WP4.3, deliverable D-8).
#
# Nothing in this file is a secret. It only points at where things live on
# the host: the SSH private key stays wherever the compose file mounts it
# from, owned by you, never checked into this repository and never baked
# into the image. apps/common/packaging scans this file for credential
# material on every commit.
#
# THE ONE SUBSTITUTION THAT MATTERS
#
# DISK below is a placeholder. A real OMV system mounts data filesystems
# at /srv/dev-disk-by-uuid-<UUID>/, and the UUID differs per machine, so
# no checked-in default can be literally correct. Find yours with
#
#     ls -d /srv/dev-disk-by-uuid-*
#
# and set DISK to it. Every host path in backup-manager.yml is written as
# ${DISK}/..., so the UUID appears exactly once on your system rather than
# five times, and this is the only line you have to change. Leave DISK
# unset or misspell it and the deployment refuses to start rather than
# creating five directories in the wrong place: the compose file uses the
# ${DISK:?...} form, so there is no fallback to fall into.
#
# apps/common/packaging fails the build if a variable declared here is
# referenced by nothing in the compose file, which is what would have
# caught the earlier version of this file, where DISK was documented as
# the one substitution that mattered and was in fact read by nothing.
DISK=/srv/dev-disk-by-uuid

# The canonical OCI image. No registry is configured for this repository
# yet, so this reference does not resolve until you push it somewhere or
# load a saved image locally; see step 0.2 of
# docs/acceptance/openmediavault-provider-acceptance.md. Change it here
# and nowhere else.
IMAGE=ghcr.io/spdrman/backup-manager:1.0.0

# The account the containers run as. Must already own the state directory
# and the backup root: the runtime image is distroless, with no shell and
# no root step, so nothing inside the container can chown them at startup.
# Check yours with `id <your-admin-user>`.
PUID=1000
PGID=100

# The host port the Web UI is published on. Do not collide with the OMV
# Workbench's own port.
WEB_PORT=8080

# Externally reachable base URL for the one-time enrollment link the
# engine prints on first start. "localhost" is only right when you open
# the link on the NAS itself; set your host's real name to get a link that
# works from another machine.
PUBLIC_BASE_URL=http://localhost:8080
