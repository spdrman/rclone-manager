# Environment for backup-manager.yml, pasted into the environment field of
# Container Manager -> Project (issue #169).
#
# Nothing in this file is a secret. It only points at where things live on
# the NAS: the SSH private key stays wherever the compose file mounts it
# from, owned by you, never checked into this repository and never baked
# into the image. distribution/packaging scans this file for credential
# material on every commit.
#
# THE TWO SUBSTITUTIONS THAT MATTER
#
# APPDATA is this project's own directory. /volume1/docker is Container
# Manager's default project location; change the volume number to match
# your NAS. It holds private application state, the configuration
# directory and the key material, and it is deliberately NOT inside the
# backup root: section 19.2 makes those two separate security domains.
APPDATA=/volume1/docker/backup-manager

# BACKUP_ROOT is the DSM shared folder retained artifacts land in, and
# nothing else. Create it in Control Panel -> Shared Folder first: a bind
# mount does not create its source, and Docker would otherwise make a
# directory of that name on whichever volume it resolves to.
BACKUP_ROOT=/volume1/backup-manager

# The canonical OCI image. The registry is settled and nothing has been
# pushed to it yet (distribution/packaging/canonical.json is the single
# source of truth for this reference and records image.published: false),
# so it does not resolve until you push it somewhere or load a saved
# image with `docker load`. Change it here and nowhere else.
IMAGE=ghcr.io/spdrman/backup-manager:0.1.0

# The account the containers run as. Must already own APPDATA and
# BACKUP_ROOT: the runtime image is distroless, with no shell and no root
# step, so nothing inside the container can chown them at startup. DSM
# gives the first local user uid 1026 and the `users` group gid 100; check
# yours over SSH with `id <your-user>`.
PUID=1026
PGID=100

# Retention is evaluated against calendar boundaries, so this is not
# cosmetic. Set it to the NAS's own timezone.
TZ=UTC

# The host port the Web UI is published on. Do not collide with DSM's own
# ports, and note the .spk uses 8477 for the same listener, so both can be
# installed side by side while you compare them.
WEB_PORT=8080

# Externally reachable base URL for the one-time enrollment link the
# engine prints on first start. "localhost" is only right when you open
# the link on the NAS itself.
PUBLIC_BASE_URL=http://localhost:8080
