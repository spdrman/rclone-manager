# Fetched, not authored. build-upk.sh pulls the canonical release by
# digest and saves it here; committing an exported image tar would put a
# copy of the release in git, and a stale one the moment the release
# moves. The sidecar goes with it: it describes the tar beside it and
# means nothing without it.
/rootfs_amd64/
/rootfs_arm64/

# Drawn by draw-icon.py, for the reasons in that file's own docstring.
/rootfs_common/icon.png

# ugcli's own output.
/build_dir/
*.upk
