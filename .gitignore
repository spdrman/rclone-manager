# Go
*.exe
*.test
*.out
/backup-manager
/dist/
/bin/

# SQLite journals produced by local runs
*.db
*.db-shm
*.db-wal

# Local config that may carry host keys or credentials
config.local.*
*.local.yaml

.DS_Store

# Agent worktrees, local only
.claude/

# A filled-in .env points at real key material on the host, and container/.env
# is what compose reads. The example stays tracked, the real one must not be.
.env
container/.env

# --- Frontend (ui/, apps/) -----------------------------------------------
# node_modules/ ignores the DIRECTORY. `**/node_modules/**` only ignores its
# CONTENTS, which leaves the directory entry itself untracked and not ignored,
# so `git clean -fd` and `git stash --include-untracked` delete the whole tree.
# Keep BOTH lines: the first protects the directory, the second still covers
# nested node_modules inside packages.
node_modules/
**/node_modules/**

# Vite/tsc build output. ui/shared/dist is what gets embedded into the Go
# binary at release time, so it is generated, never committed.
/ui/shared/dist/
/ui/shared/.vite/
*.tsbuildinfo

# Playwright runtime artifacts. The specs under ui/shared/e2e/ are source and
# stay tracked; what a run writes is not.
/ui/shared/playwright-report/
/ui/shared/test-results/
/ui/shared/playwright/.cache/

# Coverage
/ui/shared/coverage/

# --- Python (scripts/deploy) ----------------------------------------------
__pycache__/
*.pyc

# scripts/deploy/deploy_generic.py's own default --deploy-dir: rendered
# config.yaml/.env, which (per that script's own doc) point at real host
# key paths - generated locally, never committed, matching container/.env's
# own gitignore entry above.
/container/.generated/

# scripts/tests/ci-local-gate.test.sh sandbox: synthetic checkouts it builds,
# runs the gate against, and deletes again. Inside the repo rather than
# $TMPDIR so a test never creates or removes anything outside the checkout it
# belongs to.
/.ci-local-gate-test/
