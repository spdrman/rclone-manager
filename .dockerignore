# Keep the container build context to exactly what container/Dockerfile
# COPYs (core/, apps/common/, apps/generic/, ui/shared/) plus whatever
# Docker itself needs to see this file. Everything else here would either
# bloat the context for no reason or actively undermine reproducibility:
# the Dockerfile passes -buildvcs=false precisely because the build isn't
# supposed to depend on .git being present or clean, so .git is excluded
# rather than merely ignored by that flag.
.git
.github
.claude

# Local dependency/build-output directories: Docker's COPY does not
# consult .gitignore, so these have to be excluded here too, or a
# developer machine that happens to have them installed locally would
# copy them straight into the build context (platform-specific binaries,
# megabytes of files, none of it needed - the frontend-build stage runs
# its own `npm ci` and `npm run build` from scratch).
**/node_modules
ui/shared/dist
ui/shared/.vite
ui/shared/coverage
ui/shared/playwright-report
ui/shared/test-results
apps/generic/webui/dist
*.tsbuildinfo

# Not needed by the build; excluding them keeps an in-progress edit to one
# of these from invalidating Docker's layer cache for no reason.
docs
container
README.md
*.md

# Test fixtures and their scratch output; never part of the shipped binary.
# core/tests, not tests: the root tests/ moved under core/ with #106/B1.1,
# and the un-prefixed pattern is dead today (the current Dockerfile never
# COPYs anything that would match it) but would silently stop excluding
# anything the day a future COPY core/ ... starts matching it instead.
core/tests

# Never let a filled-in .env reach the build context.
.env
container/.env
